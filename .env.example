# Copy to .env and fill in. Never commit real keys.

# Default provider is Gemini (free tier via Google AI Studio):
#   https://aistudio.google.com/apikey
RAG_LLM_PROVIDER=gemini
GOOGLE_API_KEY=

# Optional model overrides (defaults shown)
# RAG_LLM_MODEL=gemini-3.6-flash
# RAG_EMBED_MODEL=models/gemini-embedding-001
# RAG_EMBED_PROVIDER=gemini

# --- Alternative: OpenAI ---
# RAG_LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# RAG_LLM_MODEL=gpt-4o-mini
# RAG_EMBED_MODEL=text-embedding-3-small

# --- Alternative: Anthropic for chat (embeddings still need OpenAI or Gemini) ---
# RAG_LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# RAG_LLM_MODEL=claude-3-5-haiku-latest
# RAG_EMBED_PROVIDER=openai
# OPENAI_API_KEY=sk-...

# Optional RAG overrides
# RAG_TOP_K=4
# RAG_MAX_RETRIES=2
# RAG_SNR_DB=12.0
# RAG_CHANNEL=AWGN

# DeepSC tool (channel_sim)
# DEEPSC_CHECKPOINT=saved_models/deepsc_AWGN.pth
# DEEPSC_VOCAB=data/vocab.json
# DEEPSC_CHANNEL=AWGN
# DEEPSC_SNR=10.0
